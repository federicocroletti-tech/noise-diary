{
  "name": "noise-diary",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production --base-href ./",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:open": "cap open android",
    "watch": "ng build --watch --configuration development --base-href ./",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "lint": "prettier --check \"**/*.md\" \"**/*.yml\" \"tools/**/*.mjs\"",
    "content:check": "node tools/content-check.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@neon/auth": "^0.8.2",
    "@neon/neon-js": "^0.10.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
